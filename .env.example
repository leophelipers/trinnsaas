# ==============================================================================
# KRIATIVA.APP — VARIÁVEIS DE AMBIENTE (PRODUÇÃO & DESENVOLVIMENTO)
# Copie este arquivo para .env.local e preencha com suas credenciais reais.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONVEX BACKEND (https://dashboard.convex.dev)
# ------------------------------------------------------------------------------
# URL do cluster Convex (obtido com `npx convex deploy` para produção)
NEXT_PUBLIC_CONVEX_URL=https://seu-deployment.convex.cloud

# Segredo compartilhado entre os Route Handlers do Next.js e as mutações restritas do Convex
INTERNAL_CONVEX_SECRET=gere_uma_chave_aleatoria_longa_aqui_ex_openssl_rand_hex_32

# ------------------------------------------------------------------------------
# 2. CLERK AUTHENTICATION (https://dashboard.clerk.com)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_SEU_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_live_SEU_CLERK_SECRET_KEY

# Domínio do emissor JWT para validação de identidade no Convex (auth.config.ts)
# Configure também no Convex Dashboard (Settings -> Environment Variables)
CLERK_JWT_ISSUER_DOMAIN=https://seu-app.clerk.accounts.dev
CLERK_FRONTEND_API_URL=https://seu-app.clerk.accounts.dev

# Segredo Svix do Webhook do Clerk (configurado no Convex Dashboard para /clerk-users-webhook)
CLERK_WEBHOOK_SECRET=whsec_seu_secret_svix_aqui

# Rotas de redirecionamento de autenticação
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ------------------------------------------------------------------------------
# 3. MERCADO PAGO — GATEWAY DE PAGAMENTOS (https://www.mercadopago.com.br/developers)
# ------------------------------------------------------------------------------
# Token de acesso de produção (ou teste)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-access-token-aqui
# Chave pública para tokenização segura de cartão de crédito no cliente
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-sua-public-key-aqui
# URL pública do webhook (ex: https://seu-dominio.com/api/mercadopago/webhook)
MERCADOPAGO_NOTIFICATION_URL=https://seu-dominio.com/api/mercadopago/webhook

# ------------------------------------------------------------------------------
# 4. PROCESSAMENTO DE IA & MOTORES DE RENDERIZAÇÃO
# ------------------------------------------------------------------------------
# RunPod Serverless API Key (motores ComfyUI: Krea-2, FastH3, LTX-2.5)
RUNPOD_API_KEY=rpa_sua_chave_runpod_aqui

# Higgsfield API (modelo ByteDance Seedance 2.5 - formato key-id:key-secret)
HF_CREDENTIALS=key-id:key-secret

# OpenRouter API Key (modelos multimodais de Chat / Kriativa Muse)
OPENROUTER_API_KEY=sk-or-v1-sua-chave-openrouter-aqui
