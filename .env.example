# Clerk Authentication Keys
# Obtenha em: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_SEU_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_SEU_CLERK_SECRET_KEY

# Clerk Redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Convex Deployment URL
# Gerado ao rodar `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Clerk Frontend API URL / JWT Issuer Domain (para autenticação no backend do Convex)
# Encontrado no dashboard do Clerk em Setup Convex ou JWT Templates -> Convex
CLERK_JWT_ISSUER_DOMAIN=https://your-issuer.clerk.accounts.dev
CLERK_FRONTEND_API_URL=https://your-issuer.clerk.accounts.dev

